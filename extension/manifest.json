{
  "manifest_version": 3,
  "name": "petty: Reader",
  "short_name": "petty: Reader",
  "version": "0.1.0",
  "description": "Read articles and text PDFs like a book. Every feature free. No license key, no account, no tracking.",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Read as a book (Alt+Shift+B)",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "declarativeNetRequestWithHostAccess"],
  "optional_host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+B" } }
  }
}
